# Copy to .env. Server-only secrets; never expose these to the web app.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Neon connection string (pooled). Each Vercel preview gets its own branch.
DATABASE_URL=
# Neon Auth id of the demo user; the seed attaches the demo data to it
DEMO_USER_ID=demo-user

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PLAN_MONTHLY_NGN=
PAYSTACK_PLAN_MONTHLY_USD=
PAYSTACK_PLAN_YEARLY_NGN=
PAYSTACK_PLAN_YEARLY_USD=
