# Copy to .env. Server-only secrets; never expose these to the web app.
APP_ENV=development
# The web app's address; the first one is where Paystack sends people back after paying
FRONTEND_ORIGIN=http://localhost:3000

# Neon connection string (pooled). Each Vercel preview gets its own branch.
DATABASE_URL=
# Neon Auth URL; db:seed signs the demo user up there (DEMO_PASSWORD matches the web app's)
NEON_AUTH_BASE_URL=
DEMO_PASSWORD=

# Verifying session tokens: <NEON_AUTH_BASE_URL>/.well-known/jwks.json, and the token audience,
# which is the origin of NEON_AUTH_BASE_URL (https://ep-....neonauth....neon.tech)
AUTH_JWKS_URL=
AUTH_AUDIENCE=

# LLM providers, tried in this order; models default to the ones in app/config.py
GROQ_API_KEY=
GEMINI_API_KEY=

PAYSTACK_SECRET_KEY=

# Scratch database for `pnpm eval` (the chat suite wipes and reseeds it)
EVAL_DATABASE_URL=
