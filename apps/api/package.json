{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --port 8000",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "typecheck": "uv run pyright",
    "test": "uv run pytest -q",
    "db:migrate": "uv run python -m scripts.db migrate",
    "db:seed": "uv run python -m scripts.db seed",
    "openapi": "uv run python -m scripts.openapi",
    "eval": "uv run python ../../evals/run.py"
  }
}
