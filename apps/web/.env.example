# Copy to .env.local.
# Where /api/* is forwarded (server-side only). Locally the API runs on :8000.
API_ORIGIN=http://localhost:8000
# Previews only: where /api/* goes when the branch's API preview URL can't be predicted
API_PRODUCTION_ORIGIN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Auth: the project's Auth URL (Neon console > Auth), and a 32+ character secret
# for the session cookie (openssl rand -base64 32)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# "Try the demo" signs into this account; the API's db:seed creates it with the same password
DEMO_EMAIL=demo@finsight.app
DEMO_PASSWORD=
